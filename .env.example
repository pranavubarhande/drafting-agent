# stub | ollama | gemini
MODEL_PROVIDER=stub

OLLAMA_BASE_URL=http://localhost:11434/v1
# gemma2:9b is the default (better quality, still Gemma-class).
# gemma2:2b is also pulled as a faster fallback for quick iteration.
OLLAMA_MODEL=gemma2:9b

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash
